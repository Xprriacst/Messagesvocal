# --- AllMySMS (MVR Mailing Vocal Direct Répondeur) ---
# Identifiants : https://www.allmysms.com/ -> mon compte -> API
ALLMYSMS_LOGIN=
ALLMYSMS_API_KEY=

# Override base URL (défaut https://api.allmysms.com)
ALLMYSMS_BASE_URL=

# Numéro émetteur fixe FR par défaut (national, ex: 0123456789)
# Obligatoire pour le MVR (ARCEP). Mobile interdit en envoi de masse.
# Préfixe accepté : 01, 02, 03, 04, 05, 09. Modifiable par campagne dans l'UI.
ALLMYSMS_DEFAULT_SENDER=

# --- App ---
# URL publique de l'app (nécessaire car AllMySMS télécharge le MP3 depuis
# /api/audio/[id]). Sur Netlify Production cette URL est auto-déduite des
# headers, mais en cas de proxy / domaine custom, force-la ici.
# Ex: https://mon-app.netlify.app
PUBLIC_BASE_URL=

# Mot de passe pour protéger l'accès au dashboard. Vide = pas de gate.
# (NB: la route publique /api/audio/[id] reste accessible pour AllMySMS.)
APP_PASSWORD=
