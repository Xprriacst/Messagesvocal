# Voice Partner API key - https://www.voicepartner.fr/
VOICE_PARTNER_API_KEY=

# Default sender name shown to recipient (optional, fallback "VoiceCast")
VOICE_PARTNER_SENDER=VoiceCast

# Optional override of base URL (defaults to https://api.voicepartner.fr)
VOICE_PARTNER_BASE_URL=https://api.voicepartner.fr

# Simple password gate for the dashboard. Leave empty to disable.
APP_PASSWORD=
